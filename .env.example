# Copy to .env and fill in real values. Never commit .env.

# --- API ---------------------------------------------------------------
# Required. Every API call (CLI included) must send this as a Bearer token.
# Generate with: openssl rand -hex 32
SHIPFLOW_API_TOKEN=replace-with-output-of-openssl-rand-hex-32

# Comma-separated URL prefixes of repositories that may be deployed.
SHIPFLOW_ALLOWED_REPO_PREFIXES=https://github.com/your-github-user/

# URL users open to see the active deployment.
PUBLIC_SITE_URL=http://localhost:8080/

# Host interfaces/ports for the API and site (docker compose only).
# Keep 127.0.0.1 and use a reverse proxy with TLS for remote access.
API_BIND=127.0.0.1
API_HOST_PORT=8000
SITE_BIND=127.0.0.1
SITE_HOST_PORT=8080

# --- Storage (S3) --------------------------------------------------------
# Use an IAM user/role limited to this bucket (see README). On EC2, prefer an
# instance role and leave the key variables empty.
AWS_REGION=eu-north-1
S3_BUCKET_NAME=your-private-bucket-name
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for S3-compatible stores (e.g. local testing):
# S3_ENDPOINT=http://localhost:9090
# S3_FORCE_PATH_STYLE=true

# --- PostgreSQL ------------------------------------------------------------
# DB_HOST/DB_PORT are overridden inside docker compose.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=shipflow
DB_PASSWORD=replace-with-a-strong-password
DB_NAME=shipflow

# --- Redis -----------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- Worker / build limits (optional) ---------------------------------------
# SHIPFLOW_SANDBOX=docker            # "none" = no isolation, local dev only
# SHIPFLOW_SANDBOX_IMAGE=node:22-alpine
# SHIPFLOW_SANDBOX_MEMORY=1g
# SHIPFLOW_SANDBOX_CPUS=1
# SHIPFLOW_WORKER_CONCURRENCY=1
# SHIPFLOW_MAX_QUEUED=5
# SHIPFLOW_REQUIRE_TESTS=false       # "true" fails releases without tests
# SHIPFLOW_INSTALL_TIMEOUT_MS=600000
# SHIPFLOW_BUILD_TIMEOUT_MS=600000
# SHIPFLOW_TEST_TIMEOUT_MS=300000
