# ShipFlow server configuration. Copy to .env and fill in. Never commit .env.
# Generate random values with: openssl rand -hex 32

# --- Required -----------------------------------------------------------------
# Bearer token for the API (the CLI sends it). At least 24 characters.
SHIPFLOW_API_TOKEN=replace-with-a-local-token
# PostgreSQL password used by the bundled database container.
DB_PASSWORD=replace-with-a-strong-password
# Repositories that may be deployed (comma-separated URL prefixes).
SHIPFLOW_ALLOWED_REPO_PREFIXES=https://github.com/your-github-user/

# --- Deployment secrets -----------------------------------------------------------
# Encrypts per-project deployment secrets (e.g. SSH keys) at rest.
# Required for the "ssh" target. 64 hex characters. Keep a copy: losing it
# makes stored secrets unreadable.
SHIPFLOW_SECRETS_KEY=

# --- Artifact storage -------------------------------------------------------------
# Leave S3_BUCKET_NAME empty to keep artifacts on this host (Docker volume
# "artifacts"); no cloud account needed. Set it to use an S3 bucket instead.
# SHIPFLOW_ARTIFACT_STORE=local          # or: s3
S3_BUCKET_NAME=
AWS_REGION=ap-south-1
# Prefer an instance role on EC2; otherwise a key limited to the bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for S3-compatible stores:
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=true

# --- Site server ("shipflow" target) ----------------------------------------------
# URL users open for the default site; host-routed projects use their hostname.
PUBLIC_SITE_URL=http://localhost:8080/
# Serve this project for requests whose Host matches no project (optional).
# SHIPFLOW_SITE_DEFAULT_PROJECT=

# --- Network exposure (docker compose) ----------------------------------------------
# Keep 127.0.0.1 and put a TLS reverse proxy in front for remote access.
API_BIND=127.0.0.1
API_HOST_PORT=8000
SITE_BIND=127.0.0.1
SITE_HOST_PORT=8080

# --- GitHub webhooks (optional) -------------------------------------------------------
# Shared secret configured on the GitHub webhook. Webhooks are off when empty.
# SHIPFLOW_GITHUB_WEBHOOK_SECRET=

# --- Limits and retention (optional, defaults shown) ----------------------------------------
# SHIPFLOW_WORKER_CONCURRENCY=1
# SHIPFLOW_MAX_QUEUED=5
# SHIPFLOW_KEEP_RELEASES=10            # stored releases per project (0 = keep all)
# SHIPFLOW_LOG_RETENTION_DAYS=90       # 0 = keep forever
# SHIPFLOW_MIN_FREE_DISK_MB=1024
# SHIPFLOW_SANDBOX_MEMORY=1g
# SHIPFLOW_SANDBOX_CPUS=1
# SHIPFLOW_SANDBOX_PIDS=512
# SHIPFLOW_INSTALL_TIMEOUT_MS=600000
# SHIPFLOW_BUILD_TIMEOUT_MS=600000
# SHIPFLOW_TEST_TIMEOUT_MS=300000
# SHIPFLOW_REQUIRE_TESTS=false
# SHIPFLOW_EGRESS_ALLOWLIST=registry.npmjs.org,registry.yarnpkg.com,repo.yarnpkg.com

# --- Database (defaults match the bundled container) ----------------------------------------
DB_USER=shipflow
DB_NAME=shipflow

# --- Web dashboard -------------------------------------------------------------------
# The API serves the dashboard at /ui when it is built (ui/dist). Set to off to disable.
# SHIPFLOW_UI=off
# SHIPFLOW_UI_DIR=/path/to/ui/dist

# --- RepoPilot (optional, OFF by default) ----------------------------------------------
# AI-assisted analysis and pull requests. Full guide: docs/repopilot.md.
# Everything below is safe to put in .env EXCEPT the worker secrets, which go in
# repopilot-worker.env (see repopilot-worker.env.example). The API refuses to
# enable RepoPilot if it can see the GitHub token or the credential private key.
# REPOPILOT=enabled
# Sandbox verification of patches. "off" (default) means patches are reported as
# inconclusive. Do NOT enable until an isolated runner has been provisioned and validated.
# REPOPILOT_SANDBOX=off
# Public half of the key pair that seals customers' AI provider keys (generate
# with: node dist/src/repopilot/keygen.js). Public key only; never the private key.
# REPOPILOT_CREDENTIAL_PUBLIC_KEY_FILE=/run/secrets/repopilot_credential_public.pem
# Private repositories send their code to your AI provider; keep false unless intended.
# REPOPILOT_ALLOW_PRIVATE=false
# Open pull requests as drafts (default true).
# REPOPILOT_PR_DRAFT=true
# REPOPILOT_AI_MODEL=claude-sonnet-5-5
# REPOPILOT_MAX_ACTIVE_RUNS=3
# REPOPILOT_MAX_AI_REQUESTS=8
# REPOPILOT_MAX_AI_INPUT_TOKENS=200000
# REPOPILOT_MAX_AI_OUTPUT_TOKENS=40000
# REPOPILOT_EVIDENCE_RETENTION_DAYS=90
