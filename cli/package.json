{
  "name": "shipflow-cli",
  "version": "0.1.1",
  "description": "CLI for ShipFlow, a self-hosted CI/CD and static-site deployment server",
  "type": "module",
  "bin": {
    "shipflow": "./dist/index.js"
  },
  "files": [
    "dist/",
    "!dist/.tsbuildinfo",
    "!dist/**/*.map",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-ec2": "^3.1073.0",
    "@aws-sdk/client-sts": "^3.1073.0",
    "yaml": "^2.9.1"
  },
  "keywords": [
    "cicd",
    "deployment",
    "cli",
    "self-hosted",
    "static-site"
  ],
  "author": "Shiv Singh Baghel",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shivsingh78/shipflow.git",
    "directory": "cli"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "tsc -p tsconfig.json"
  }
}
