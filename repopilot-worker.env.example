# Secrets for the RepoPilot worker ONLY. Copy to repopilot-worker.env (git-ignored).
# Never put these in .env: the API shares that file and must not be able to read them.

# Fine-grained GitHub personal access token, limited to the repositories you want
# analysed. Needs: Contents (read & write, to create the repopilot/* branch) and
# Pull requests (read & write). No admin, no workflow, no merge-related permissions.
REPOPILOT_GITHUB_TOKEN=

# PRIVATE key that unseals customers' AI provider keys. Mount a file and point at it.
# The matching PUBLIC key goes to the API (.env). Generate both with:
#   node dist/src/repopilot/keygen.js ./repopilot-keys
REPOPILOT_CREDENTIAL_PRIVATE_KEY_FILE=/run/secrets/repopilot_credential_private.pem
