# Optional settings for `pnpm dev` in this folder. Copy to ui/.env (git-ignored).
# Contains no secrets: you sign in with your API token in the browser, and it is
# never read from this file.

# Where the dev server proxies API calls (the ShipFlow API from docker compose or `pnpm dev` at the repo root).
# SHIPFLOW_API_URL=http://127.0.0.1:8000
